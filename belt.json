{
  "formatVersion": "0.3-draft",
  "name": "our-tool-belt",
  "version": "0.3.0",
  "description": "Our portable workshop for APIs, data and browser-tested applications.",
  "rules": [
    "rules/working-agreement.md",
    "rules/engineering.md"
  ],
  "skills": [
    "skills/build-api-slice/SKILL.md",
    "skills/reconcile-data/SKILL.md",
    "skills/verify-browser-flow/SKILL.md",
    "skills/evaluate-mcp/SKILL.md"
  ],
  "servers": [
    {
      "id": "github",
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "headersFromEnv": {
        "Authorization": {
          "env": "GITHUB_MCP_TOKEN",
          "prefix": "Bearer "
        }
      },
      "status": "needs-credentials"
    },
    {
      "id": "context7",
      "transport": "http",
      "url": "https://mcp.context7.com/mcp",
      "headersFromEnv": {
        "CONTEXT7_API_KEY": {
          "env": "CONTEXT7_API_KEY",
          "prefix": ""
        }
      },
      "status": "needs-credentials"
    },
    {
      "id": "playwright",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--isolated",
        "--headless"
      ],
      "status": "needs-local-setup"
    }
  ],
  "personalServers": [],
  "models": [
    {
      "id": "local-ai",
      "api": "openai-compatible",
      "env": {
        "baseUrl": "LOCAL_AI_BASE_URL",
        "model": "LOCAL_AI_MODEL",
        "apiKey": "LOCAL_AI_API_KEY"
      },
      "defaultPreset": "ollama",
      "presets": {
        "ollama": {
          "baseUrl": "http://localhost:11434/v1",
          "model": "gemma4:e2b",
          "docs": "https://docs.ollama.com/api/openai-compatibility"
        },
        "lm-studio": {
          "baseUrl": "http://localhost:1234/v1",
          "model": "",
          "docs": "https://lmstudio.ai/docs/developer/openai-compat"
        },
        "llama-cpp": {
          "baseUrl": "http://localhost:8080/v1",
          "model": "",
          "docs": "https://github.com/ggml-org/llama.cpp/tree/master/tools/server"
        },
        "vllm": {
          "baseUrl": "http://localhost:8000/v1",
          "model": "",
          "docs": "https://docs.vllm.ai/en/latest/serving/openai_compatible_server/"
        }
      },
      "status": "needs-local-setup"
    }
  ],
  "packages": [
    {
      "id": "playwright-mcp",
      "kind": "npm",
      "name": "@playwright/mcp",
      "version": "0.0.83",
      "description": "Microsoft's Playwright MCP server used by the playwright connection."
    },
    {
      "id": "mcp-inspector",
      "kind": "npm",
      "name": "@modelcontextprotocol/inspector",
      "version": "2.9.0",
      "description": "The MCP project's Inspector; its CLI mode runs scripts/mcp_smoke.py connection smoke tests."
    },
    {
      "id": "styling",
      "kind": "files",
      "path": "styling",
      "version": "0.1.0",
      "description": "Tool Belt design tokens as CSS variables and JSON."
    },
    {
      "id": "zizmor",
      "kind": "pypi",
      "name": "zizmor",
      "version": "1.30.1",
      "description": "zizmor GitHub Actions security linter, run on .github/workflows by the Workflow security lint workflow."
    },
    {
      "id": "actionlint",
      "kind": "pypi",
      "name": "actionlint-py",
      "version": "1.7.12.25",
      "description": "rhysd/actionlint via the actionlint-py wrapper; CI lints workflow files for syntax and structural mistakes."
    }
  ],
  "adapters": [
    "claude-code",
    "vscode",
    "cursor",
    "opencode"
  ],
  "secretRefs": [
    "GITHUB_MCP_TOKEN",
    "CONTEXT7_API_KEY",
    "LOCAL_AI_API_KEY"
  ]
}
